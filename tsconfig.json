{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@afx/core": ["packages/core/src/index.ts"],
      "@afx/llm": ["packages/llm/src/index.ts"],
      "@afx/ingest": ["packages/ingest/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "packages/*/test/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
