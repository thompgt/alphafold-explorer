{
  "name": "alphafold-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "npm run migrate -w @afx/core",
    "ingest": "npm run ingest -w @afx/ingest",
    "annotate": "npm run annotate -w @afx/ingest",
    "embed": "npm run embed -w @afx/ingest",
    "api": "npm run dev -w @afx/api",
    "web": "npm run dev -w @afx/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
