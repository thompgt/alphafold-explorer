# DuckDB
AFX_DB_PATH=./data/afdb.duckdb

# Ollama (host install by default; containers use host.docker.internal)
OLLAMA_HOST=http://127.0.0.1:11434
AFX_CHAT_MODEL=llama3.1:8b
AFX_EMBED_MODEL=nomic-embed-text
AFX_EMBED_DIM=768

# MinIO / S3-compatible object store for CIF files
AFX_S3_ENDPOINT=http://127.0.0.1:9000
AFX_S3_BUCKET=afx-structures
AFX_S3_ACCESS_KEY=afxadmin
AFX_S3_SECRET_KEY=afxadmin123

# API
AFX_API_PORT=3000
